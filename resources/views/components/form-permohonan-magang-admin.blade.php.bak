                class="w-full px-6 py-3 rounded-lg bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 dark:from-blue-700 dark:to-blue-800 dark:hover:from-blue-800 dark:hover:to-blue-900 text-white font-semibold transition">
                <i class="fas fa-paper-plane mr-2"></i>{{ $is_edit ? 'Perbarui' : 'Kirim' }} Permohonan
            </button>
